  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Just-One Jake\nJake is heading home from a themed party at LA Bar, which
    started with \u201Cjust one beer\u201D, but ended with a beer tower and an honorary
    spot on the bar\u2019s notorious Drunk Tank Honours. He\u2019s now on his way
    home on his road bike with a blood alcohol level that\u2019s left him half blind,
    fully convinced he knows the city like the back of his hand. He didn\u2019t wear
    a helmet, obviously. It would\u2019ve ruined his fade, and that\u2019s just not
    an option, because Jake is a 100% lookmaxxer."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
